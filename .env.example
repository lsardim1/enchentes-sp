# Copie para .env.local. Gere as chaves VAPID com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# Segredo exigido por GET /api/push/verificar (Authorization: Bearer <segredo>) para disparos por cron externo.
CRON_SECRET=
# Intervalo (min) do verificador interno de novos alertas; 0 desliga.
PUSH_POLL_MINUTES=10
# Arquivo de persistência das inscrições (padrão: .data/push.json). Troque por um banco em produção multi-instância.
# PUSH_STORE=.data/push.json
